{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @longshot/shared build && pnpm --filter @longshot/app build"
  },
  "deploy": {
    "startCommand": "node scripts/start.mjs",
    "healthcheckPath": "/api/broker/catalog",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
