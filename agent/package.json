{
  "name": "@longshot/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@longshot/shared": "workspace:*",
    "tsx": "^4.23.15",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "worker": "tsx --env-file-if-exists=../.env src/worker.ts",
    "worker:once": "tsx --env-file-if-exists=../.env src/worker.ts --once",
    "deploy:all": "tsx --env-file=../.env scripts/deploy.ts",
    "template:test": "tsx scripts/template-test.ts",
    "predict:test": "tsx scripts/predict-test.ts",
    "stats:test": "tsx scripts/stats-test.ts",
    "model:ping": "tsx --env-file-if-exists=../.env scripts/model-ping.ts"
  }
}
