{
  "name": "longshot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "pnpm --filter @longshot/shared build && pnpm --filter @longshot/app build",
    "start": "node scripts/start.mjs",
    "dev": "pnpm --filter @longshot/shared build && pnpm --filter @longshot/app dev",
    "worker": "pnpm --filter @longshot/agent worker",
    "deploy:contracts": "cd contracts && forge build && cd .. && pnpm --filter @longshot/agent deploy:all",
    "fixtures:sync": "pnpm --filter @longshot/app fixtures:sync",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @longshot/agent template:test && pnpm --filter @longshot/agent predict:test && pnpm --filter @longshot/agent stats:test && pnpm --filter @longshot/shared score:test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
