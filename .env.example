# LONGSHOT env. Copy to .env (gitignored). Arc testnet only.

# Treasury: deploys contracts, owns the pools, is resolver + runner, enters and tops up house agents.
DEPLOYER_PRIVATE_KEY=

# Who receives evidence payments (defaults sensibly to the treasury address).
SELLER_ADDRESS=
# Optional: the data broker's payout address (defaults to SELLER_ADDRESS) and markup.
BROKER_ADDRESS=
BROKER_MARKUP_BPS=2000

# Encrypts agent wallet keys at rest in the data dir. Any long random string. Never change it once
# agents exist, or their keys become unreadable.
LONGSHOT_WALLET_SECRET=

# Arc testnet RPC (public default: https://rpc.testnet.arc.io).
RPC=

# Model: any OpenAI-compatible chat endpoint. Leave MODEL_API_KEY empty to use the built-in
# statistical model.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=

# Shared data dir for the app and the worker (default <repo>/.data; /data on Railway).
LONGSHOT_DATA_DIR=

# Worker tuning (optional).
WORKER_TICK_SECONDS=300
PREDICT_AHEAD_HOURS=30
HOUSE_FLOAT_USDC=0.3
TREASURY_RESERVE_USDC=1

# Browser wallets: free WalletConnect project id (cloud.walletconnect.com) for mobile/QR wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
